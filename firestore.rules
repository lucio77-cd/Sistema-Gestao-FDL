rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // IDENTIDADE E ISOLAMENTO POR ESTABELECIMENTO
    // =========================================================

    function autenticado() {
      return request.auth != null;
    }

    function donoDoEstabelecimento(id) {
      return autenticado()
        && id is string
        && exists(/databases/$(database)/documents/estabelecimentos/$(id))
        && get(/databases/$(database)/documents/estabelecimentos/$(id)).data.ownerId == request.auth.uid;
    }

    function donoDosDados(data) {
      return data.estabelecimentoId is string
        && donoDoEstabelecimento(data.estabelecimentoId);
    }

    function mesmoEstabelecimento() {
      return donoDosDados(request.resource.data)
        && request.resource.data.estabelecimentoId == resource.data.estabelecimentoId
        && donoDoEstabelecimento(resource.data.estabelecimentoId);
    }

    function textoOpcional(data, campo, maximo) {
      return !(campo in data)
        || data[campo] == null
        || (data[campo] is string && data[campo].size() <= maximo);
    }

    function numeroOpcional(data, campo, minimo, maximo) {
      return !(campo in data)
        || data[campo] == null
        || (data[campo] is number && data[campo] >= minimo && data[campo] <= maximo);
    }

    function dataOpcional(data, campo) {
      return !(campo in data)
        || data[campo] == null
        || (data[campo] is string && data[campo].matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }

    function localValido(local) {
      return local in ['geladeira', 'seco', 'Geladeira', 'Estoque seco', 'ambos', 'geral'];
    }

    function produtoDoEstabelecimento(produtoId, estabelecimentoId) {
      return produtoId is string
        && exists(/databases/$(database)/documents/produtos/$(produtoId))
        && get(/databases/$(database)/documents/produtos/$(produtoId)).data.estabelecimentoId == estabelecimentoId;
    }

    // =========================================================
    // ESTABELECIMENTOS
    // =========================================================

    match /estabelecimentos/{id} {
      allow get, list: if autenticado()
        && resource.data.ownerId == request.auth.uid;

      // O cliente nunca cria, transfere a propriedade ou exclui
      // um estabelecimento. A criação inicial deve ser administrativa.
      allow create, delete: if false;

      allow update: if autenticado()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nome', 'diasAlertaPadrao', 'baixaAutomaticaAtiva', 'ultimaVistoria'
        ])
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.nome.size() <= 120
        && numeroOpcional(request.resource.data, 'diasAlertaPadrao', 0, 365)
        && (!('baixaAutomaticaAtiva' in request.resource.data)
          || request.resource.data.baixaAutomaticaAtiva is bool)
        && (!('ultimaVistoria' in request.resource.data)
          || request.resource.data.ultimaVistoria is timestamp);
    }

    // =========================================================
    // PRODUTOS
    // =========================================================

    function produtoValido(data) {
      return data.nome is string
        && data.nome.size() > 0
        && data.nome.size() <= 160
        && textoOpcional(data, 'marca', 100)
        && textoOpcional(data, 'categoria', 100)
        && textoOpcional(data, 'variante', 100)
        && textoOpcional(data, 'embalagem', 80)
        && textoOpcional(data, 'volume', 40)
        && textoOpcional(data, 'codigoBarras', 80)
        && numeroOpcional(data, 'precoCusto', 0, 1000000)
        && numeroOpcional(data, 'precoVenda', 0, 1000000)
        && numeroOpcional(data, 'diasAlerta', 0, 365)
        && numeroOpcional(data, 'estoqueMinimo', 0, 1000000)
        && (!('localEstoque' in data) || data.localEstoque in ['geladeira', 'seco'])
        && (!('locaisEstoque' in data)
          || (data.locaisEstoque is list
            && data.locaisEstoque.size() >= 1
            && data.locaisEstoque.size() <= 2
            && data.locaisEstoque.hasOnly(['geladeira', 'seco'])))
        && (!('ativo' in data) || data.ativo is bool)
        && (!('criadoEm' in data) || data.criadoEm is timestamp)
        && (!('atualizadoEm' in data) || data.atualizadoEm is timestamp);
    }

    match /produtos/{id} {
      allow read: if donoDosDados(resource.data);
      allow create: if donoDosDados(request.resource.data)
        && request.resource.data.keys().hasOnly([
          'estabelecimentoId', 'nome', 'marca', 'categoria',
          'localEstoque', 'locaisEstoque', 'variante', 'embalagem',
          'volume', 'codigoBarras', 'precoCusto', 'precoVenda',
          'diasAlerta', 'estoqueMinimo', 'ativo', 'criadoEm', 'atualizadoEm'
        ])
        && produtoValido(request.resource.data);
      allow update: if mesmoEstabelecimento()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nome', 'marca', 'categoria', 'localEstoque', 'locaisEstoque',
          'variante', 'embalagem', 'volume', 'codigoBarras',
          'precoCusto', 'precoVenda', 'diasAlerta', 'estoqueMinimo',
          'ativo', 'atualizadoEm'
        ])
        && produtoValido(request.resource.data);
      allow delete: if false;
    }

    // =========================================================
    // SALDO CONSOLIDADO
    // =========================================================

    function estoqueValido(data, id) {
      return textoOpcional(data, 'produtoNome', 180)
        && (!('produtoId' in data) || (data.produtoId is string && data.produtoId == id))
        && numeroOpcional(data, 'geladeira', 0, 1000000)
        && numeroOpcional(data, 'seco', 0, 1000000)
        && (!('atualizadoEm' in data) || data.atualizadoEm is timestamp)
        && (!('ultimaContagemEm' in data) || data.ultimaContagemEm is timestamp);
    }

    match /estoque/{id} {
      allow read: if donoDosDados(resource.data);
      allow create: if donoDosDados(request.resource.data)
        && request.resource.data.keys().hasOnly([
          'estabelecimentoId', 'produtoId', 'produtoNome',
          'geladeira', 'seco', 'atualizadoEm', 'ultimaContagemEm'
        ])
        && estoqueValido(request.resource.data, id)
        && (!('produtoId' in request.resource.data)
          || produtoDoEstabelecimento(request.resource.data.produtoId, request.resource.data.estabelecimentoId));
      allow update: if mesmoEstabelecimento()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'produtoId', 'produtoNome', 'geladeira', 'seco',
          'atualizadoEm', 'ultimaContagemEm'
        ])
        && estoqueValido(request.resource.data, id)
        && (!('produtoId' in request.resource.data)
          || produtoDoEstabelecimento(request.resource.data.produtoId, request.resource.data.estabelecimentoId));
      allow delete: if false;
    }

    // =========================================================
    // LOTES E VALIDADE
    // =========================================================

    function loteValido(data) {
      return data.produtoId is string
        && data.produtoNome is string
        && data.produtoNome.size() > 0
        && data.quantidade is number
        && data.quantidade >= 0
        && data.quantidade <= 1000000
        && data.local in ['Geladeira', 'Estoque seco']
        && numeroOpcional(data, 'precoCusto', 0, 1000000)
        && numeroOpcional(data, 'diasAlerta', 0, 365)
        && dataOpcional(data, 'dataVencimento')
        && (!('promocaoAtiva' in data) || data.promocaoAtiva is bool)
        && numeroOpcional(data, 'precoPromocional', 0, 1000000)
        && (!('importadoParaEstoque' in data) || data.importadoParaEstoque is bool)
        && (!('encerrado' in data) || data.encerrado is bool)
        && textoOpcional(data, 'motivoEncerramento', 40)
        && (!('encerradoEm' in data) || data.encerradoEm is timestamp)
        && (!('transferidoEm' in data) || data.transferidoEm is timestamp)
        && textoOpcional(data, 'transferidoDeLoteId', 160);
    }

    match /lotes/{id} {
      allow read: if donoDosDados(resource.data);
      allow create: if donoDosDados(request.resource.data)
        && request.resource.data.keys().hasOnly([
          'estabelecimentoId', 'produtoId', 'produtoNome', 'precoCusto',
          'diasAlerta', 'quantidade', 'local', 'dataVencimento',
          'promocaoAtiva', 'precoPromocional', 'importadoParaEstoque',
          'encerrado', 'motivoEncerramento', 'encerradoEm',
          'transferidoEm', 'transferidoDeLoteId'
        ])
        && loteValido(request.resource.data)
        && produtoDoEstabelecimento(request.resource.data.produtoId, request.resource.data.estabelecimentoId);
      allow update: if mesmoEstabelecimento()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'produtoNome', 'precoCusto', 'diasAlerta', 'quantidade',
          'local', 'dataVencimento', 'promocaoAtiva', 'precoPromocional',
          'importadoParaEstoque', 'encerrado', 'motivoEncerramento',
          'encerradoEm', 'transferidoEm', 'transferidoDeLoteId'
        ])
        && loteValido(request.resource.data)
        && produtoDoEstabelecimento(request.resource.data.produtoId, request.resource.data.estabelecimentoId);
      allow delete: if false;
    }

    // =========================================================
    // LIVRO DE MOVIMENTAÇÕES (SOMENTE INCLUSÃO)
    // =========================================================

    function movimentoValido(data) {
      return data.keys().hasOnly([
          'estabelecimentoId', 'produtoId', 'produtoNome', 'local',
          'tipo', 'quantidade', 'delta', 'origem', 'registradoEm',
          'deLocal', 'paraLocal', 'geladeira', 'seco',
          'quantidadeContada', 'deltaMovimentacoesPosteriores', 'sessaoId'
        ])
        && data.produtoId is string
        && data.produtoNome is string
        && data.produtoNome.size() > 0
        && localValido(data.local)
        && data.tipo in [
          'entrada', 'venda', 'perda', 'vencido', 'ajuste',
          'transferencia_saida', 'transferencia_entrada',
          'contagem', 'importacao'
        ]
        && data.registradoEm is timestamp
        && textoOpcional(data, 'origem', 60)
        && textoOpcional(data, 'sessaoId', 180)
        && textoOpcional(data, 'deLocal', 30)
        && textoOpcional(data, 'paraLocal', 30)
        && numeroOpcional(data, 'quantidade', 0, 1000000)
        && numeroOpcional(data, 'delta', -1000000, 1000000)
        && numeroOpcional(data, 'geladeira', 0, 1000000)
        && numeroOpcional(data, 'seco', 0, 1000000)
        && numeroOpcional(data, 'quantidadeContada', 0, 1000000)
        && numeroOpcional(data, 'deltaMovimentacoesPosteriores', -1000000, 1000000);
    }

    match /movimentosEstoque/{id} {
      allow read: if donoDosDados(resource.data);
      allow create: if donoDosDados(request.resource.data)
        && movimentoValido(request.resource.data)
        && produtoDoEstabelecimento(request.resource.data.produtoId, request.resource.data.estabelecimentoId);
      allow update, delete: if false;
    }

    // =========================================================
    // SAÍDAS (VENDAS E PERDAS)
    // =========================================================

    function saidaValida(data) {
      return data.keys().hasOnly([
          'estabelecimentoId', 'produtoId', 'produtoNome', 'motivo',
          'quantidade', 'precoCusto', 'valor', 'local',
          'dataVencimentoOriginal', 'origem', 'registradoEm'
        ])
        && data.produtoId is string
        && data.produtoNome is string
        && data.produtoNome.size() > 0
        && data.motivo in ['vendido', 'vencido']
        && data.quantidade is number
        && data.quantidade > 0
        && data.quantidade <= 1000000
        && numeroOpcional(data, 'precoCusto', 0, 1000000)
        && numeroOpcional(data, 'valor', 0, 1000000000)
        && textoOpcional(data, 'local', 40)
        && dataOpcional(data, 'dataVencimentoOriginal')
        && textoOpcional(data, 'origem', 40)
        && data.registradoEm is timestamp;
    }

    match /saidas/{id} {
      allow read: if donoDosDados(resource.data);
      allow create: if donoDosDados(request.resource.data)
        && saidaValida(request.resource.data)
        && produtoDoEstabelecimento(request.resource.data.produtoId, request.resource.data.estabelecimentoId);
      allow update, delete: if false;
    }

    // =========================================================
    // VISTORIA DE LOTES (HISTÓRICO IMUTÁVEL)
    // =========================================================

    match /vistorias/{id} {
      allow read: if donoDosDados(resource.data);
      allow create: if donoDosDados(request.resource.data)
        && request.resource.data.keys().hasOnly(['estabelecimentoId', 'data', 'itens'])
        && request.resource.data.data is timestamp
        && request.resource.data.itens is list
        && request.resource.data.itens.size() <= 500;
      allow update, delete: if false;
    }

    // =========================================================
    // VISTORIA FÍSICA DO ESTOQUE
    // =========================================================

    function sessaoDoEstabelecimento(sessaoId, estabelecimentoId) {
      return sessaoId is string
        && exists(/databases/$(database)/documents/vistoriasEstoque/$(sessaoId))
        && get(/databases/$(database)/documents/vistoriasEstoque/$(sessaoId)).data.estabelecimentoId == estabelecimentoId
        && donoDoEstabelecimento(estabelecimentoId);
    }

    match /vistoriasEstoque/{id} {
      allow read: if donoDosDados(resource.data);
      allow create: if donoDosDados(request.resource.data)
        && request.resource.data.keys().hasOnly([
          'estabelecimentoId', 'local', 'status', 'categoriaFiltro',
          'embalagemFiltro', 'criadaPor', 'criadaEm', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.local in ['geladeira', 'seco']
        && request.resource.data.status == 'em_andamento'
        && textoOpcional(request.resource.data, 'categoriaFiltro', 100)
        && textoOpcional(request.resource.data, 'embalagemFiltro', 80)
        && textoOpcional(request.resource.data, 'criadaPor', 160)
        && request.resource.data.criadaEm is timestamp
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update: if mesmoEstabelecimento()
        && resource.data.status != 'finalizada'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'updatedAt', 'finalizadaEm', 'quantidadeItensContados'
        ])
        && request.resource.data.status in ['em_andamento', 'aguardando_revisao', 'finalizada']
        && request.resource.data.updatedAt is timestamp
        && (!('finalizadaEm' in request.resource.data) || request.resource.data.finalizadaEm is timestamp)
        && numeroOpcional(request.resource.data, 'quantidadeItensContados', 0, 1000000);
      allow delete: if false;
    }

    function contagemValida(data) {
      return data.keys().hasOnly([
          'estabelecimentoId', 'sessaoId', 'produtoId', 'produtoNome',
          'local', 'quantidade', 'contadoEm', 'contadoPor', 'atualizadoEm'
        ])
        && data.sessaoId is string
        && data.produtoId is string
        && data.produtoNome is string
        && data.produtoNome.size() > 0
        && data.local in ['geladeira', 'seco']
        && data.quantidade is number
        && data.quantidade >= 0
        && data.quantidade <= 1000000
        && data.contadoEm is timestamp
        && data.atualizadoEm is timestamp
        && textoOpcional(data, 'contadoPor', 160);
    }

    match /contagensEstoque/{id} {
      allow read: if donoDosDados(resource.data);
      allow create, update: if donoDosDados(request.resource.data)
        && contagemValida(request.resource.data)
        && sessaoDoEstabelecimento(request.resource.data.sessaoId, request.resource.data.estabelecimentoId)
        && get(/databases/$(database)/documents/vistoriasEstoque/$(request.resource.data.sessaoId)).data.status in ['em_andamento', 'aguardando_revisao']
        && produtoDoEstabelecimento(request.resource.data.produtoId, request.resource.data.estabelecimentoId)
        && (!exists(/databases/$(database)/documents/contagensEstoque/$(id))
          || resource.data.estabelecimentoId == request.resource.data.estabelecimentoId);
      allow delete: if false;
    }

    // =========================================================
    // VALIDADE DOS DOCES (CONTROLE DA VENDA, SEM MOVIMENTAR ESTOQUE)
    // =========================================================

    function doceValidadeValido(data) {
      return data.nome is string
        && data.nome.size() > 0
        && data.nome.size() <= 160
        && data.quantidade is int
        && data.quantidade >= 1
        && data.quantidade <= 1000000
        && data.dataVencimento is string
        && data.dataVencimento.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && textoOpcional(data, 'produtoId', 160)
        && textoOpcional(data, 'marca', 100)
        && textoOpcional(data, 'categoria', 100)
        && textoOpcional(data, 'variante', 100)
        && textoOpcional(data, 'embalagem', 80)
        && textoOpcional(data, 'volume', 40)
        && textoOpcional(data, 'lote', 60)
        && textoOpcional(data, 'observacao', 240)
        && (!('produtoId' in data) || produtoDoEstabelecimento(data.produtoId, data.estabelecimentoId))
        && data.ativo is bool
        && data.criadoEm is timestamp
        && data.atualizadoEm is timestamp;
    }

    match /docesValidade/{id} {
      // O usuário só acessa doces vinculados ao estabelecimento que possui.
      allow read: if donoDosDados(resource.data);

      allow create: if donoDosDados(request.resource.data)
        && request.resource.data.keys().hasOnly([
          'estabelecimentoId', 'produtoId', 'nome', 'marca', 'categoria',
          'variante', 'embalagem', 'volume', 'quantidade', 'dataVencimento',
          'lote', 'observacao', 'ativo', 'criadoEm', 'atualizadoEm'
        ])
        && doceValidadeValido(request.resource.data)
        && request.resource.data.ativo == true;

      allow update: if mesmoEstabelecimento()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'produtoId', 'nome', 'marca', 'categoria', 'variante',
          'embalagem', 'volume', 'quantidade', 'dataVencimento',
          'lote', 'observacao', 'ativo', 'atualizadoEm'
        ])
        && doceValidadeValido(request.resource.data);

      // Mantém histórico: encerramento é feito pelo campo ativo=false.
      allow delete: if false;
    }

    // =========================================================
    // COZINHA
    // =========================================================

    function cozinhaItemValido(data) {
      return data.nome is string
        && data.nome.size() > 0
        && data.nome.size() <= 160
        && textoOpcional(data, 'unidade', 40)
        && textoOpcional(data, 'grupo', 80)
        && numeroOpcional(data, 'estoqueMinimo', 0, 1000000)
        && (!('ativo' in data) || data.ativo is bool)
        && (!('criadoEm' in data) || data.criadoEm is timestamp)
        && (!('atualizadoEm' in data) || data.atualizadoEm is timestamp);
    }

    match /cozinhaItens/{id} {
      allow read: if donoDosDados(resource.data);
      allow create: if donoDosDados(request.resource.data)
        && request.resource.data.keys().hasOnly([
          'estabelecimentoId', 'nome', 'unidade', 'grupo',
          'estoqueMinimo', 'ativo', 'criadoEm', 'atualizadoEm'
        ])
        && cozinhaItemValido(request.resource.data);
      allow update: if mesmoEstabelecimento()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nome', 'unidade', 'grupo', 'estoqueMinimo', 'ativo', 'atualizadoEm'
        ])
        && cozinhaItemValido(request.resource.data);
      allow delete: if false;
    }

    function cozinhaVistoriaValida(data) {
      return data.keys().hasOnly([
          'estabelecimentoId', 'dia', 'data', 'itens',
          'totalItens', 'totalConferidos', 'criadoPor',
          'excluida', 'excluidaEm', 'excluidaPor'
        ])
        && data.dia is string
        && data.data is timestamp
        && data.itens is list
        && data.itens.size() <= 500
        && data.totalItens is int
        && data.totalItens >= 0
        && data.totalConferidos is int
        && data.totalConferidos >= 0
        && data.totalConferidos <= data.totalItens
        && textoOpcional(data, 'criadoPor', 160)
        && (!('excluida' in data) || data.excluida is bool)
        && (!('excluidaEm' in data) || data.excluidaEm is timestamp)
        && textoOpcional(data, 'excluidaPor', 160);
    }

    match /cozinhaVistorias/{id} {
      allow read: if donoDosDados(resource.data);
      allow create: if donoDosDados(request.resource.data)
        && cozinhaVistoriaValida(request.resource.data);
      allow update: if mesmoEstabelecimento()
        && (!('excluida' in resource.data) || resource.data.excluida != true)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'excluida', 'excluidaEm', 'excluidaPor'
        ])
        && request.resource.data.excluida == true
        && request.resource.data.excluidaEm is timestamp
        && textoOpcional(request.resource.data, 'excluidaPor', 160);
      allow delete: if false;
    }

    // Nenhuma outra coleção é acessível pelo cliente por padrão.
  }
})
        && textoOpcional(data, 'produtoId', 160)
        && textoOpcional(data, 'marca', 100)
        && textoOpcional(data, 'categoria', 100)
        && textoOpcional(data, 'variante', 100)
        && textoOpcional(data, 'embalagem', 80)
        && textoOpcional(data, 'volume', 40)
        && textoOpcional(data, 'lote', 60)
        && textoOpcional(data, 'observacao', 240)
        && (!('produtoId' in data) || produtoDoEstabelecimento(data.produtoId, data.estabelecimentoId))
        && data.ativo is bool
        && data.criadoEm is timestamp
        && data.atualizadoEm is timestamp;
    }

    match /docesValidade/{id} {
      // O usuário só acessa doces vinculados ao estabelecimento que possui.
      allow read: if donoDosDados(resource.data);

      allow create: if donoDosDados(request.resource.data)
        && request.resource.data.keys().hasOnly([
          'estabelecimentoId', 'nome', 'quantidade', 'dataVencimento',
          'observacao', 'ativo', 'criadoEm', 'atualizadoEm'
        ])
        && doceValidadeValido(request.resource.data)
        && request.resource.data.ativo == true;

      allow update: if mesmoEstabelecimento()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nome', 'quantidade', 'dataVencimento', 'observacao',
          'ativo', 'atualizadoEm'
        ])
        && doceValidadeValido(request.resource.data);

      // Mantém histórico: encerramento é feito pelo campo ativo=false.
      allow delete: if false;
    }

    // =========================================================
    // COZINHA
    // =========================================================

    function cozinhaItemValido(data) {
      return data.nome is string
        && data.nome.size() > 0
        && data.nome.size() <= 160
        && textoOpcional(data, 'unidade', 40)
        && textoOpcional(data, 'grupo', 80)
        && numeroOpcional(data, 'estoqueMinimo', 0, 1000000)
        && (!('ativo' in data) || data.ativo is bool)
        && (!('criadoEm' in data) || data.criadoEm is timestamp)
        && (!('atualizadoEm' in data) || data.atualizadoEm is timestamp);
    }

    match /cozinhaItens/{id} {
      allow read: if donoDosDados(resource.data);
      allow create: if donoDosDados(request.resource.data)
        && request.resource.data.keys().hasOnly([
          'estabelecimentoId', 'nome', 'unidade', 'grupo',
          'estoqueMinimo', 'ativo', 'criadoEm', 'atualizadoEm'
        ])
        && cozinhaItemValido(request.resource.data);
      allow update: if mesmoEstabelecimento()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nome', 'unidade', 'grupo', 'estoqueMinimo', 'ativo', 'atualizadoEm'
        ])
        && cozinhaItemValido(request.resource.data);
      allow delete: if false;
    }

    function cozinhaVistoriaValida(data) {
      return data.keys().hasOnly([
          'estabelecimentoId', 'dia', 'data', 'itens',
          'totalItens', 'totalConferidos', 'criadoPor',
          'excluida', 'excluidaEm', 'excluidaPor'
        ])
        && data.dia is string
        && data.data is timestamp
        && data.itens is list
        && data.itens.size() <= 500
        && data.totalItens is int
        && data.totalItens >= 0
        && data.totalConferidos is int
        && data.totalConferidos >= 0
        && data.totalConferidos <= data.totalItens
        && textoOpcional(data, 'criadoPor', 160)
        && (!('excluida' in data) || data.excluida is bool)
        && (!('excluidaEm' in data) || data.excluidaEm is timestamp)
        && textoOpcional(data, 'excluidaPor', 160);
    }

    match /cozinhaVistorias/{id} {
      allow read: if donoDosDados(resource.data);
      allow create: if donoDosDados(request.resource.data)
        && cozinhaVistoriaValida(request.resource.data);
      allow update: if mesmoEstabelecimento()
        && (!('excluida' in resource.data) || resource.data.excluida != true)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'excluida', 'excluidaEm', 'excluidaPor'
        ])
        && request.resource.data.excluida == true
        && request.resource.data.excluidaEm is timestamp
        && textoOpcional(request.resource.data, 'excluidaPor', 160);
      allow delete: if false;
    }

    // Nenhuma outra coleção é acessível pelo cliente por padrão.
  }
}