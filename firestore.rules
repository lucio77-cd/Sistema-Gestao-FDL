rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // "estabelecimentos" e "lotes" têm leitura pública porque a página da
    // gerente (gerente.html) acessa via link com token, sem login. O nome e
    // preço de custo do produto ficam gravados diretamente no lote
    // (denormalizado) — assim a gerente nunca precisa ler "produtos", que é
    // restrita.
    // O proprietário precisa corresponder ao ownerId do estabelecimento.
    function donoDoEstabelecimento(estabelecimentoId) {
      return request.auth != null
        && estabelecimentoId is string
        && exists(/databases/$(database)/documents/estabelecimentos/$(estabelecimentoId))
        && get(/databases/$(database)/documents/estabelecimentos/$(estabelecimentoId)).data.ownerId == request.auth.uid;
    }

    match /estabelecimentos/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Coleções que sustentam o estoque físico. A consulta do app filtra
    // por estabelecimentoId; updates não podem transferir documentos.
    match /estoque/{id} {
      allow read: if donoDoEstabelecimento(resource.data.estabelecimentoId);
      allow create: if donoDoEstabelecimento(request.resource.data.estabelecimentoId);
      allow update: if donoDoEstabelecimento(resource.data.estabelecimentoId)
        && request.resource.data.estabelecimentoId == resource.data.estabelecimentoId;
      allow delete: if donoDoEstabelecimento(resource.data.estabelecimentoId);
    }

    match /movimentosEstoque/{id} {
      allow read: if donoDoEstabelecimento(resource.data.estabelecimentoId);
      allow create: if donoDoEstabelecimento(request.resource.data.estabelecimentoId);
      allow update: if donoDoEstabelecimento(resource.data.estabelecimentoId)
        && request.resource.data.estabelecimentoId == resource.data.estabelecimentoId;
      allow delete: if donoDoEstabelecimento(resource.data.estabelecimentoId);
    }

    match /vistoriasEstoque/{id} {
      allow read: if donoDoEstabelecimento(resource.data.estabelecimentoId);
      allow create: if donoDoEstabelecimento(request.resource.data.estabelecimentoId);
      allow update: if donoDoEstabelecimento(resource.data.estabelecimentoId)
        && request.resource.data.estabelecimentoId == resource.data.estabelecimentoId;
      allow delete: if donoDoEstabelecimento(resource.data.estabelecimentoId);
    }

    match /contagensEstoque/{id} {
      allow read: if donoDoEstabelecimento(resource.data.estabelecimentoId);
      allow create: if donoDoEstabelecimento(request.resource.data.estabelecimentoId);
      allow update: if donoDoEstabelecimento(resource.data.estabelecimentoId)
        && request.resource.data.estabelecimentoId == resource.data.estabelecimentoId;
      allow delete: if donoDoEstabelecimento(resource.data.estabelecimentoId);
    }

    match /lotes/{id} {
      allow read: if true;
      // A gerente (sem login) pode ajustar só o valor de venda promocional
      // de um item que vai vencer — nunca quantidade, vencimento ou outro
      // campo. Qualquer outra alteração continua exigindo login.
      allow update: if request.auth != null ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["precoPromocional", "promocaoAtiva"]);
      allow create, delete: if request.auth != null;
    }

    // Produtos (custo, código de barras) e vistorias ficam restritos ao
    // operador logado.
    match /produtos/{id} {
      allow read, write: if request.auth != null;
    }

    match /vistorias/{id} {
      allow read, write: if request.auth != null;
    }

    // Coleção única para "saiu do estoque ativo" (vendido ou vencido),
    // substituindo as antigas "excluidos" e "perdas".
    match /saidas/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
