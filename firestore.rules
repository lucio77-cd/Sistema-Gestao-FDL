rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function donoDoEstabelecimento(estabelecimentoId) {
      return autenticado()
        && exists(
          /databases/$(database)/documents/estabelecimentos/$(estabelecimentoId)
        )
        && get(
          /databases/$(database)/documents/estabelecimentos/$(estabelecimentoId)
        ).data.ownerId == request.auth.uid;
    }

    function podeAcessarDados(dados) {
      return dados.keys().hasAll(['estabelecimentoId'])
        && donoDoEstabelecimento(dados.estabelecimentoId);
    }

    // Cada usuário autenticado só acessa o próprio estabelecimento.
    match /estabelecimentos/{id} {
      allow get, list: if autenticado()
        && resource.data.ownerId == request.auth.uid;

      allow create: if autenticado()
        && request.resource.data.ownerId == request.auth.uid;

      allow update: if autenticado()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid;

      allow delete: if false;
    }

    // Produtos: somente o dono do estabelecimento associado pode acessar.
    match /produtos/{id} {
      allow read, delete: if podeAcessarDados(resource.data);

      allow create: if podeAcessarDados(request.resource.data);

      allow update: if podeAcessarDados(resource.data)
        && podeAcessarDados(request.resource.data);
    }

    // Permite get autenticado de documento inexistente para tratar concorrência
    // (por exemplo, um lote removido entre a consulta e a transação). Documentos
    // existentes continuam restritos ao dono do estabelecimento.
    match /lotes/{id} {
      allow get: if autenticado()
        && (resource == null || podeAcessarDados(resource.data));
      allow list: if podeAcessarDados(resource.data);
      allow delete: if podeAcessarDados(resource.data);
      allow create: if podeAcessarDados(request.resource.data);
      allow update: if podeAcessarDados(resource.data)
        && podeAcessarDados(request.resource.data);
    }

    // O Caixa lê o documento de saldo mesmo quando ainda não existe; isso não
    // revela dados de outro estabelecimento porque só libera get de inexistente.
    match /estoque/{id} {
      allow get: if autenticado()
        && (resource == null || podeAcessarDados(resource.data));
      allow list: if podeAcessarDados(resource.data);
      allow delete: if podeAcessarDados(resource.data);
      allow create: if podeAcessarDados(request.resource.data);
      allow update: if podeAcessarDados(resource.data)
        && podeAcessarDados(request.resource.data);
    }

    // Histórico de vistorias: leitura e criação; sem edição ou exclusão pelo cliente.
    match /vistorias/{id} {
      allow read: if podeAcessarDados(resource.data);
      allow create: if podeAcessarDados(request.resource.data);
      allow update, delete: if false;
    }

    // Histórico de movimentações: leitura e criação; sem edição ou exclusão pelo cliente.
    match /movimentosEstoque/{id} {
      allow read: if podeAcessarDados(resource.data);
      allow create: if podeAcessarDados(request.resource.data);
      allow update, delete: if false;
    }

    // Saídas (vendidos e vencidos): histórico imutável pelo cliente.
    match /saidas/{id} {
      allow read: if podeAcessarDados(resource.data);
      allow create: if podeAcessarDados(request.resource.data);
      allow update, delete: if false;
    }
  }
}
