rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Confirma que o usuário autenticado é o proprietário
    // do estabelecimento informado.
    function usuarioAutorizado(estabelecimentoId) {
      return request.auth != null
        && estabelecimentoId is string
        && exists(
          /databases/$(database)/documents/estabelecimentos/$(estabelecimentoId)
        )
        && get(
          /databases/$(database)/documents/estabelecimentos/$(estabelecimentoId)
        ).data.ownerId == request.auth.uid;
    }

    // Impede que um documento seja transferido para outro
    // estabelecimento durante uma atualização.
    function mesmoEstabelecimento() {
      return request.resource.data.estabelecimentoId
        == resource.data.estabelecimentoId;
    }

    // Estabelecimentos
    match /estabelecimentos/{id} {
      // O usuário pode consultar somente seus estabelecimentos.
      allow read: if request.auth != null
        && resource.data.ownerId == request.auth.uid;

      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;

      // O proprietário não pode transferir a propriedade
      // para outro usuário por uma atualização.
      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;

      allow delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }

    // Produtos
    match /produtos/{id} {
      allow read: if usuarioAutorizado(
        resource.data.estabelecimentoId
      );

      allow create: if usuarioAutorizado(
        request.resource.data.estabelecimentoId
      );

      allow update: if usuarioAutorizado(
          resource.data.estabelecimentoId
        )
        && mesmoEstabelecimento();

      allow delete: if usuarioAutorizado(
        resource.data.estabelecimentoId
      );
    }

    // Estoque agregado por produto e local
    match /estoque/{id} {
      allow read: if usuarioAutorizado(
        resource.data.estabelecimentoId
      );

      allow create: if usuarioAutorizado(
        request.resource.data.estabelecimentoId
      );

      allow update: if usuarioAutorizado(
          resource.data.estabelecimentoId
        )
        && mesmoEstabelecimento();

      allow delete: if usuarioAutorizado(
        resource.data.estabelecimentoId
      );
    }

    // Histórico de movimentações do estoque: somente leitura e criação.
    match /movimentosEstoque/{id} {
      allow read: if usuarioAutorizado(
        resource.data.estabelecimentoId
      );

      allow create: if usuarioAutorizado(
        request.resource.data.estabelecimentoId
      );

      allow update, delete: if false;
    }

    // Sessões de vistoria física do estoque
    match /vistoriasEstoque/{id} {
      allow read: if usuarioAutorizado(
        resource.data.estabelecimentoId
      );

      allow create: if usuarioAutorizado(
        request.resource.data.estabelecimentoId
      );

      allow update: if usuarioAutorizado(
          resource.data.estabelecimentoId
        )
        && mesmoEstabelecimento();

      allow delete: if usuarioAutorizado(
        resource.data.estabelecimentoId
      );
    }

    // Contagens individuais de produtos por sessão
    match /contagensEstoque/{id} {
      allow read: if usuarioAutorizado(
        resource.data.estabelecimentoId
      );

      allow create: if usuarioAutorizado(
        request.resource.data.estabelecimentoId
      );

      allow update: if usuarioAutorizado(
          resource.data.estabelecimentoId
        )
        && mesmoEstabelecimento();

      allow delete: if usuarioAutorizado(
        resource.data.estabelecimentoId
      );
    }

    // Lotes e respectivas validades
    match /lotes/{id} {
      allow read: if usuarioAutorizado(
        resource.data.estabelecimentoId
      );

      allow create: if usuarioAutorizado(
        request.resource.data.estabelecimentoId
      );

      allow update: if usuarioAutorizado(
          resource.data.estabelecimentoId
        )
        && mesmoEstabelecimento();

      allow delete: if usuarioAutorizado(
        resource.data.estabelecimentoId
      );
    }

    // Saídas: vendas, perdas e outros encerramentos de lotes.
    // O histórico não pode ser alterado ou apagado.
    match /saidas/{id} {
      allow read: if usuarioAutorizado(
        resource.data.estabelecimentoId
      );

      allow create: if usuarioAutorizado(
        request.resource.data.estabelecimentoId
      );

      allow update, delete: if false;
    }

    // Vistorias antigas: histórico imutável após a criação.
    match /vistorias/{id} {
      allow read: if usuarioAutorizado(
        resource.data.estabelecimentoId
      );

      allow create: if usuarioAutorizado(
        request.resource.data.estabelecimentoId
      );

      allow update, delete: if false;
    }

    // Coleção legada de perdas: permite consultar o histórico
    // do próprio estabelecimento, sem criar, alterar ou apagar registros.
    match /perdas/{id} {
      allow read: if usuarioAutorizado(
        resource.data.estabelecimentoId
      );

      allow create, update, delete: if false;
    }
  }
}