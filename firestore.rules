rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // "estabelecimentos" e "lotes" têm leitura pública porque a página da
    // gerente (gerente.html) acessa via link com token, sem login. O nome e
    // preço de custo do produto ficam gravados diretamente no lote
    // (denormalizado) — assim a gerente nunca precisa ler "produtos", que é
    // restrita e não deveria ser pública (tem preço de custo/venda).
    // Isso é uma simplificação consciente para o MVP: qualquer pessoa com o
    // link do documento pode ler. Se isso virar um problema (múltiplos
    // estabelecimentos, dados mais sensíveis), migrar a validação de token
    // para uma Cloud Function que gere um custom token de leitura.
    match /estabelecimentos/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /lotes/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Produtos (tem preço de custo/venda), vistorias e perdas não têm
    // necessidade de leitura pública — ficam restritos ao operador logado.
    match /produtos/{id} {
      allow read, write: if request.auth != null;
    }

    match /vistorias/{id} {
      allow read, write: if request.auth != null;
    }

    match /perdas/{id} {
      allow read, write: if request.auth != null;
    }

    match /excluidos/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
