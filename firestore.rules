rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // O acesso é limitado ao proprietário do estabelecimento associado.
    // As consultas do aplicativo devem continuar filtrando por estabelecimentoId.
    function autenticado() {
      return request.auth != null;
    }

    function donoDoEstabelecimento(estabelecimentoId) {
      return autenticado()
        && estabelecimentoId is string
        && exists(/databases/$(database)/documents/estabelecimentos/$(estabelecimentoId))
        && get(/databases/$(database)/documents/estabelecimentos/$(estabelecimentoId)).data.ownerId == request.auth.uid;
    }

    function dadosDoProprioEstabelecimento(dados) {
      return dados.keys().hasAll(['estabelecimentoId'])
        && donoDoEstabelecimento(dados.estabelecimentoId);
    }

    function atualizacaoNoMesmoEstabelecimento() {
      return dadosDoProprioEstabelecimento(resource.data)
        && dadosDoProprioEstabelecimento(request.resource.data)
        && request.resource.data.estabelecimentoId == resource.data.estabelecimentoId;
    }

    // O estabelecimento só pode ser consultado e administrado pelo proprietário.
    match /estabelecimentos/{id} {
      allow read: if autenticado() && resource.data.ownerId == request.auth.uid;

      allow create: if autenticado()
        && request.resource.data.ownerId == request.auth.uid;

      allow update: if autenticado()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId;

      allow delete: if false;
    }

    // Cadastro de produtos: exclusão física bloqueada para preservar referências históricas.
    match /produtos/{id} {
      allow read: if dadosDoProprioEstabelecimento(resource.data);
      allow create: if dadosDoProprioEstabelecimento(request.resource.data);
      allow update: if atualizacaoNoMesmoEstabelecimento();
      allow delete: if false;
    }

    // Lotes: exclusão é necessária quando um lote zera por venda ou baixa de vencimento.
    match /lotes/{id} {
      allow read: if dadosDoProprioEstabelecimento(resource.data);
      allow create: if dadosDoProprioEstabelecimento(request.resource.data);
      allow update: if atualizacaoNoMesmoEstabelecimento();
      allow delete: if dadosDoProprioEstabelecimento(resource.data);
    }

    // Saldo agregado por produto e local.
    match /estoque/{id} {
      allow read: if dadosDoProprioEstabelecimento(resource.data);
      allow create: if dadosDoProprioEstabelecimento(request.resource.data);
      allow update: if atualizacaoNoMesmoEstabelecimento();
      allow delete: if false;
    }

    // Histórico de movimentações: o cliente cria e consulta, mas não altera ou apaga.
    match /movimentosEstoque/{id} {
      allow read: if dadosDoProprioEstabelecimento(resource.data);
      allow create: if dadosDoProprioEstabelecimento(request.resource.data);
      allow update, delete: if false;
    }

    // Sessões de vistoria física: podem avançar de estado, mas não ser apagadas pelo cliente.
    match /vistoriasEstoque/{id} {
      allow read: if dadosDoProprioEstabelecimento(resource.data);
      allow create: if dadosDoProprioEstabelecimento(request.resource.data);
      allow update: if atualizacaoNoMesmoEstabelecimento();
      allow delete: if false;
    }

    // Contagens vinculadas a uma sessão de vistoria.
    match /contagensEstoque/{id} {
      allow read: if dadosDoProprioEstabelecimento(resource.data);
      allow create: if dadosDoProprioEstabelecimento(request.resource.data);
      allow update: if atualizacaoNoMesmoEstabelecimento();
      allow delete: if false;
    }

    // Histórico de vistorias de lotes: somente leitura e criação.
    match /vistorias/{id} {
      allow read: if dadosDoProprioEstabelecimento(resource.data);
      allow create: if dadosDoProprioEstabelecimento(request.resource.data);
      allow update, delete: if false;
    }

    // Saídas: histórico de vendas, vencimentos e encerramentos de lotes.
    match /saidas/{id} {
      allow read: if dadosDoProprioEstabelecimento(resource.data);
      allow create: if dadosDoProprioEstabelecimento(request.resource.data);
      allow update, delete: if false;
    }

    // Itens da cozinha: exclusão lógica é feita pelo campo ativo.
    match /cozinhaItens/{id} {
      allow read: if dadosDoProprioEstabelecimento(resource.data);
      allow create: if dadosDoProprioEstabelecimento(request.resource.data);
      allow update: if atualizacaoNoMesmoEstabelecimento();
      allow delete: if false;
    }

    // Vistorias da cozinha: o código permite exclusão explícita pelo proprietário.
    match /cozinhaVistorias/{id} {
      allow read: if dadosDoProprioEstabelecimento(resource.data);
      allow create: if dadosDoProprioEstabelecimento(request.resource.data);
      allow update: if atualizacaoNoMesmoEstabelecimento();
      allow delete: if dadosDoProprioEstabelecimento(resource.data);
    }

    // Compatibilidade de leitura para registros antigos de perdas.
    match /perdas/{id} {
      allow read: if dadosDoProprioEstabelecimento(resource.data);
      allow create, update, delete: if false;
    }

    // Coleções não declaradas permanecem negadas por padrão.
  }
}
